.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
# Raw state files stay on this Mac only. They include administrator names, phone numbers and
# street addresses, so they are never saved in git (decide separately where they live if this
# project goes to GitHub). The published JSON in site/data/ has none of those fields.
inbox/*
!inbox/.gitkeep
snapshots/*
!snapshots/.gitkeep
# Geocode cache and reports for the members' map: street addresses, private only.
geocache/
# Members' map files (street addresses), built here and uploaded to private storage only.
mapbuild/

# Cloudflare command-line tool cache (created by wrangler); never part of the site.
.wrangler/
# Early-access Worker: local build output and local-only test settings (never real secrets in git).
early-access/dist/
early-access/.dev.vars
early-access/dev/.mock-sheet.json
# Local clone of the private data repository (Weekly Movers reports, raw files). Never in this repo.
private-data/
# Sample Weekly Movers reports for review on this Mac (private: holds street addresses).
movers-sample/
