  "signal_rules": [
    {
      "key": "on_probation",
      "label": "On probation",
      "rule": "Facility Status is ON PROBATION in the current snapshot."
    },
    {
      "key": "substantiated_12m",
      "label": "Substantiated allegations, last 12 months",
      "rule": "The facility is not closed and the state's complaint detail lists at least one substantiated allegation on a complaint dated on or after the same calendar day one year before the as-of date."
    },
    {
      "key": "recent_status_change",
      "label": "Closed or changed status, last 90 days",
      "rule": "The facility had a License First Date and its Closed Date is within the last 90 days, or our weekly comparison recorded a status change within the last 90 days. Weekly comparisons start with the first snapshot we hold."
    },
    {
      "key": "complaints_12m",
      "label": "3+ complaints, last 12 months",
      "rule": "The facility is not closed and the state's complaint detail lists 3 or more complaints dated in the last 12 months. This counts complaints, not complaint visits, because only the complaint detail carries dates."
    }
  ],
  "signal_disclaimer": "Flags come from public state records, may be out of date, and do not indicate a facility's quality or value. Each flag is shown on its own; they are not added together. Errors in a record can only be corrected by the California Department of Social Services.",
  "event_types": [
    {
      "key": "new_facility",
      "label": "New facility"
    },
    {
      "key": "status_change",
      "label": "Status change"
    },
    {
      "key": "licensee_change",
      "label": "Licensee change"
    },
    {
      "key": "capacity_change",
      "label": "Capacity change"
    },
    {
      "key": "new_substantiated_allegations",
      "label": "New substantiated allegations"
    },
    {
      "key": "new_complaint_visits",
      "label": "New complaint visits"
    }
  ],
  "definitions": {
    "licensee_withheld": {
      "label": "Withheld names",
      "rule": "Where a licensee name is the same person's name as a facility administrator anywhere in the state file, it is shown as withheld, because this site does not publish administrator names. Names match when they have the same words in any order (for example \"LAST, FIRST\" and \"FIRST LAST\"), ignoring initials and punctuation. The facility is still counted everywhere. A facility name that is an administrator's name (a home listed under a person's own name) is withheld the same way."
    },
    "scope": {
      "label": "Which facilities are counted",
      "rule": "Headline numbers count every facility in the state RCFE file. The \"Excluding CCRCs\" view leaves out continuing care retirement communities (Facility Type RCFE-CONTINUING CARE RETIREMENT COMMUNITY): RCFE-licensed campuses that also sell continuing-care contracts. Facilities with a blank Facility Type, which are pending applications the state has not typed yet, are counted with the other RCFEs."
    },
    "size_group": {
      "label": "Home size groups",
      "rule": "6 beds or fewer, or 7 beds or more, by the Facility Capacity in the current snapshot. Week-to-week changes follow each facility's current size, so a home that changes capacity is counted in its new group and shows as a capacity change. Facilities with a blank capacity are in neither group."
    },
    "size_band": {
      "label": "Capacity bands",
      "rule": "Facility Capacity grouped as 6 or fewer, 7-15, 16-49, 50-99, and 100 or more beds."
    },
    "licensed_facilities": {
      "label": "Licensed facilities",
      "rule": "Count of facilities with Facility Status = LICENSED."
    },
    "licensed_beds": {
      "label": "Licensed beds",
      "rule": "Sum of Facility Capacity for LICENSED facilities. A blank capacity counts as 0 beds."
    },
    "median_licensed_capacity": {
      "label": "Median home size",
      "rule": "Median Facility Capacity of LICENSED facilities, in beds. Facilities with a blank capacity are left out."
    },
    "pending": {
      "label": "Pending",
      "rule": "Count of facilities with Facility Status = PENDING."
    },
    "on_probation": {
      "label": "On probation",
      "rule": "Count of facilities with Facility Status = ON PROBATION."
    },
    "new_licenses_7d": {
      "label": "New licenses, 7 days",
      "rule": "Facilities whose License First Date is on or between the as-of date minus 7 days and the as-of date (any current status)."
    },
    "new_licenses_90d": {
      "label": "New licenses, 90 days",
      "rule": "Facilities whose License First Date is on or between the as-of date minus 90 days and the as-of date (any current status)."
    },
    "closures_closed_date_7d": {
      "label": "Closures by Closed Date, 7 days",
      "rule": "Facilities that had a License First Date and whose Closed Date is on or between the as-of date minus 7 days and the as-of date. Applications that closed before a license was issued are not counted."
    },
    "closures_closed_date_90d": {
      "label": "Closures by Closed Date, 90 days",
      "rule": "Facilities that had a License First Date and whose Closed Date is on or between the as-of date minus 90 days and the as-of date. Applications that closed before a license was issued are not counted."
    },
    "citations_12m": {
      "label": "Citations, last 12 months",
      "rule": "Count of POC (plan of correction) dates on or after the same calendar day one year before the as-of date. Each citation in the file has a POC date; the citation numbers themselves carry no date."
    },
    "facilities_with_citations_12m": {
      "label": "Facilities with a citation, last 12 months",
      "rule": "Facilities with at least one POC date in the 12-month window above."
    },
    "licensees_3plus": {
      "label": "Licensees with 3+ homes",
      "rule": "Licensee names with 3 or more LICENSED facilities. Names are matched after trimming, collapsing repeated spaces and ignoring upper/lower case; no other merging is done. A licensee name that is also an administrator's name is counted but shown as withheld."
    },
    "closures_status_changed": {
      "label": "Closures by status change",
      "rule": "Facilities with a License First Date whose status was not CLOSED in the prior snapshot and is CLOSED in this one. Applications that closed before a license was issued are not counted."
    },
    "new_facility_numbers": {
      "label": "New facility numbers",
      "rule": "Facility Numbers in this snapshot that were not in the prior snapshot."
    },
    "removed_facility_numbers": {
      "label": "Facility numbers no longer listed",
      "rule": "Facility Numbers in the prior snapshot that are missing from this one."
    },
    "status_changes": {
      "label": "Status changes",
      "rule": "Facilities in both snapshots whose Facility Status differs."
    },
    "ownership_changes": {
      "label": "Ownership changes",
      "rule": "Facilities in both snapshots whose Licensee name differs, using the same name matching as Licensees with 3+ homes (spacing and case changes do not count)."
    },
    "capacity_changes": {
      "label": "Capacity changes",
      "rule": "Facilities in both snapshots whose Facility Capacity differs."
    },
    "facilities_new_substantiated": {
      "label": "Facilities with new substantiated allegations",
      "rule": "Facilities in both snapshots whose Substantiated Allegations count rose."
    },
    "new_substantiated_allegations": {
      "label": "New substantiated allegations",
      "rule": "Sum of the increases above. Decreases are not subtracted; they are counted separately in QA."
    },
    "facilities_substantiated_decreased": {
      "label": "Facilities whose substantiated allegations count fell (QA)",
      "rule": "Facilities in both snapshots whose Substantiated Allegations count dropped. Shown for quality checking only."
    },
    "facilities_new_complaint_visits": {
      "label": "Facilities with new complaint visits",
      "rule": "Facilities in both snapshots whose Complaint Visits count rose."
    },
    "new_complaint_visits": {
      "label": "New complaint visits",
      "rule": "Sum of the increases above."
    },
    "window_12m": {
      "label": "12-month window",
      "rule": "From the same calendar day one year before the as-of date through the as-of date, both days included."
    },
    "new_licenses_12m": {
      "label": "New licenses, 12 months",
      "rule": "Facilities whose License First Date is in the 12-month window (any current status)."
    },
    "closures_12m": {
      "label": "Closures, 12 months",
      "rule": "Facilities that had a License First Date and whose Closed Date is in the 12-month window. Applications that closed before a license was issued are not counted."
    },
    "net_change_12m": {
      "label": "Net change, 12 months",
      "rule": "New licenses, 12 months, minus closures, 12 months. This is not the same as the change in licensed homes: new licenses include homes that are now closed or still pending, and homes also move on and off probation."
    },
    "growth_rate_12m": {
      "label": "Growth rate, 12 months",
      "rule": "New licenses, 12 months, divided by licensed homes (Facility Status = LICENSED) in the current file."
    },
    "churn_rate_12m": {
      "label": "Churn rate, 12 months",
      "rule": "Closures, 12 months, divided by licensed homes (Facility Status = LICENSED) in the current file."
    },
    "probation_share": {
      "label": "Probation share",
      "rule": "Facilities ON PROBATION divided by facilities LICENSED or ON PROBATION. Homes on probation are still operating but are not in the licensed count, so they are added to the denominator."
    },
    "share_licensed_multi": {
      "label": "Share held by licensees with 3+ homes",
      "rule": "Licensed homes whose licensee has 3 or more LICENSED homes anywhere in the state (all facility types and sizes), divided by licensed homes. Licensee names are matched as for Licensees with 3+ homes."
    },
    "small_base": {
      "label": "Small base",
      "rule": "Rates for an area with fewer than 20 licensed homes are marked \"small base\": a few homes opening or closing moves them a lot."
    },
    "compare_with": {
      "label": "Compare with",
      "rule": "A change is this week's file minus the chosen earlier week's file, both counted under the same rules. Activity since an earlier week adds up the week-to-week comparisons in between. New licenses and closures by date add up each week's 7-day count, and are shown only when the weekly files are exactly 7 days apart. Comparisons reach back to the first saved weekly file, October 11, 2026."
    },
    "trends": {
      "label": "Trend charts",
      "rule": "One point per weekly state file, counted under the same rules as the current week. Charts appear once four weekly files are on hand."
    },
    "week_over_week": {
      "label": "Week-over-week change",
      "rule": "This snapshot's value minus the prior snapshot's value, each computed from its own file with windows measured from its own as-of date."
    }
  }
}
